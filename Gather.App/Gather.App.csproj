<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Gather.App</RootNamespace><AssemblyName>Gather</AssemblyName>
    <UseWinUI>true</UseWinUI><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\Gather.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
    <Version>0.10.0-dev.8</Version><AssemblyVersion>0.10.0.0</AssemblyVersion><FileVersion>0.10.0.8</FileVersion>
    <Product>Gather</Product><Description>A desktop home for your messaging services</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <ProjectReference Include="..\Gather.Core\Gather.Core.csproj" />
    <ProjectReference Include="..\Gather.Signal\Gather.Signal.csproj" />
    <Content Include="Assets\Gather.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <None Remove="runtimes\signal\**\*" />
    <None Include="runtimes\signal\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></None>
    <Content Include="Assets\Services\*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <None Include="..\Notices\*"><Link>Notices\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_GatherXbf Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_GatherXbf)" RelativePath="%(_GatherXbf.RecursiveDir)%(_GatherXbf.Filename)%(_GatherXbf.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
